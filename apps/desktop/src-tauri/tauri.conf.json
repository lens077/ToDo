{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sumery Virgo",
  "version": "0.1.0",
  "identifier": "com.sumery.virgo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sumery Virgo",
        "width": 1180,
        "height": 780,
        "dragDropEnabled": false
      },
      {
        "label": "capture",
        "title": "Virgo 速记",
        "width": 520,
        "height": 180,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Sumery",
    "shortDescription": "Sumery Virgo - 任务与代码现实对账",
    "longDescription": "Sumery Virgo（室女座）：给 AI 协作开发者的本地任务对账器。Markdown 是唯一事实源，界面汇总展示并写回原文件，用 Git 物证辅助对账。",
    "copyright": "© Sumery",
    "windows": {
      "nsis": {
        "startMenuFolder": "Sumery",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "signingIdentity": null
    }
  }
}
