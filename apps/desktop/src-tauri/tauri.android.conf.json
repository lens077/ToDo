{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sumery Virgo",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/files/.todo/reading/**",
          "$CACHE/files/.todo/reading/**"
        ]
      }
    }
  }
}