    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "prepack": "pnpm build"
  },
  "dsh": {
