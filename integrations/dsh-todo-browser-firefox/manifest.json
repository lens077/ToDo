{
  "manifest_version": 2,
  "name": "DSH Todo Browser",
  "version": "0.1.0",
  "description": "Open DSH Todo sessions from web pages.",
  "permissions": ["tabs"],
  "background": {"scripts": ["config.js", "background.js"]},
  "content_scripts": [{"matches": ["http://127.0.0.1/*", "http://localhost/*"], "js": ["content.js"], "all_frames": false, "run_at": "document_start"}],
  "applications": {"gecko": {"id": "dsh-todo-browser@example.invalid", "strict_min_version": "57.0"}}
}
